{
  "name": "codex-account-manager",
  "private": true,
  "version": "0.5.0-alpha.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "sdk:build": "tsc --strict --types node --target es2022 --module nodenext --moduleResolution nodenext --declaration --outDir integration/typescript/dist integration/typescript/src/index.ts integration/typescript/src/session.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "test:usability": "playwright test --config playwright.usability.config.ts",
    "icons:export": "node scripts/export-icons.mjs",
    "runtime:prepare": "node scripts/prepare-browser-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.8.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.2",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
